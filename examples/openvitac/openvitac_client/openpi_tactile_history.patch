+    def _on_executed_action(self, task, obs: dict, torch_action) -> None:
+        """Called with every abs-qpos action right before it is executed (subclasses may override)."""
+
+        if self.save_trajectory:
+            # policy.reset() runs after task.reset(next seed), so capture seed / outcome now, not at flush time.
+            self._traj_task = task
+            self._traj["seed"] = int(task.cfg.seed)
+            self._traj["save_root"] = str(task.save_root)
+            self._traj["state"].append(np.asarray(obs["observation/state"], dtype=np.float32))
+            self._traj["action"].append(torch_action.detach().cpu().numpy().astype(np.float32))
+
+    def _flush_trajectory(self) -> None:
+        """Write the finished episode to <save_root>/trajectories/<seed>_<result>.npz (abs qpos8 actions as executed)."""
+
+        task, traj = self._traj_task, self._traj
+        self._traj, self._traj_task = {"state": [], "action": []}, None
+        if task is None or not traj["action"]:
+            return
+        from pathlib import Path
+
+        result = "success" if traj.get("success", False) else "failed"
+        out = Path(traj["save_root"]) / "trajectories"
+        out.mkdir(parents=True, exist_ok=True)
+        np.savez_compressed(
+            out / f"{traj['seed']}_{result}.npz",
+            seed=traj["seed"],
+            success=result == "success",
+            state=np.stack(traj["state"]),
+            action=np.stack(traj["action"]),
+        )
+
+    def _add_tactile_history(self, obs: dict) -> None:
+        """Replace observation/<side>_tactile_image by <side>_tactile_history and <side>_tactile_background."""
+
+        n, stride = self.tactile_history_frames, self.tactile_history_stride
+        for side in ("left", "right"):
+            frames = self._tactile_frames[side]
+            frames.append(obs.pop(f"observation/{side}_tactile_image"))
+            t = len(frames) - 1
+            indices = [max(0, t - stride * (n - 1 - k)) for k in range(n)]
+            obs[f"observation/{side}_tactile_history"] = np.stack([frames[i] for i in indices])
+            obs[f"observation/{side}_tactile_background"] = frames[0]
+            # keep frame 0 (background) in place; drop frames that can no longer be indexed
+            keep_from = max(1, t - stride * (n - 1))
+            for i in range(1, keep_from):
+                frames[i] = None
+
